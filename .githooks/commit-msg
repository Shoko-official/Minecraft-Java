#!/usr/bin/env bash
# Enforces the "[KEYWORD] : Description" subject format and rejects automatic attribution.
set -euo pipefail

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

root="$(git rev-parse --show-toplevel)"

# The subject is the first line of the file. awk reads the file directly: no pipeline, hence
# no SIGPIPE on very large messages such as the diff that "git commit -v" appends.
subject="$(awk 'NR == 1 { sub(/\r$/, ""); print }' "$msg_file")"

# Empty messages are rejected by git itself.
[ -n "$subject" ] || exit 0

case "$subject" in
  "Merge branch "*|"Merge remote-tracking branch "*|"Revert \""*|"fixup! "*|"squash! "*) ;;
  *) bash "$root/scripts/check-subject.sh" "$subject" ;;
esac

bash "$root/scripts/check-hygiene.sh" --message "$msg_file"
